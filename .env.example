# ==============================================================================
# API Configuration
# ==============================================================================
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# ==============================================================================
# Database Configuration
# ==============================================================================
DB_HOST=db
DB_PORT=5432
DB_NAME=econ
DB_USER=econ_user
DB_PASSWORD=econ_pass

# Full database URL for API (used by SQLAlchemy and Alembic)
DATABASE_URL=postgresql+psycopg://econ_user:econ_pass@db:5432/econ

# ==============================================================================
# Web (Next.js) Configuration
# ==============================================================================
# API base URL accessible from the browser (client-side)
# When running docker compose, set to http://api:8000
# When running the frontend on your host, set to http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://api:8000

# Web server port
WEB_PORT=3000
